#!/bin/bash

set -euo pipefail

# Define packages
declare -a packages=( ms-python.python svelte.svelte-vscode openai.chatgpt anthropic.claude-code )
target_user="${NB_USER:-jovyan}"

# Install them
for package in "${packages[@]}"
do
  if [ "$(id -u)" -eq 0 ] && [ "${target_user}" != "root" ]; then
    su - "${target_user}" -c "code-server --install-extension ${package} --force"
  else
    code-server --install-extension "${package}" --force
  fi
done

# Replace JupyterLab favicons with the Reflective monogram.
# Use the cropped favicon so the mark fills more of the 16x16 tab icon.
favicon_src="/opt/reflective/images/favicon.png"
prefix="${NB_PYTHON_PREFIX:-/srv/conda/envs/notebook}"
favicon_names=(
  favicon.ico
  favicon-busy-1.ico
  favicon-busy-2.ico
  favicon-busy-3.ico
  favicon-file.ico
  favicon-notebook.ico
  favicon-terminal.ico
)

while IFS= read -r -d '' favicon_dir; do
  for name in "${favicon_names[@]}"; do
    target="${favicon_dir}/${name}"
    if [[ -e "${target}" ]]; then
      cp "${favicon_src}" "${target}"
    fi
  done
done < <(find "${prefix}" \( -path '*/share/jupyter/lab/static/favicons' -o -path '*/share/jupyter/lab/static/base/images' -o -path '*/static/base/images' -o -path '*/static/favicons' \) -type d -print0 2>/dev/null)
